<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background: #10B981; color: white; padding: 20px; text-align: center; }
        .content { padding: 20px; border: 1px solid #ddd; border-top: none; }
        .amount { font-size: 24px; font-weight: bold; color: #10B981; margin: 20px 0; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h2>Payment Receipt</h2>
        </div>
        <div class="content">
            <p>Hi {{name}},</p>
            <p>We have successfully received your payment for the course: <strong>{{courseName}}</strong>.</p>
            <div class="amount">Amount Paid: ₹{{amount}}</div>
            <p>Your fee status has been updated. Thank you for your payment.</p>
        </div>
    </div>
</body>
</html>
